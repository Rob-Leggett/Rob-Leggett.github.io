{
  "name": "robertleggett-site",
  "version": "1.2.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "script:generate-post-index": "node scripts/generate-post-index.js",
    "script:generate-rss": "node scripts/generate-rss.js",
    "script:generate-sitemap": "node scripts/generate-sitemap.js",
    "dev": "next dev --turbopack",
    "build": "npm run script:generate-rss && npm run script:generate-sitemap && npm run script:generate-post-index && next build",
    "start": "next start",
    "lint": "eslint .",
    "release": "semantic-release",
    "ping-search-engines": "npm run ping:bing && npm run ping:yandex",
    "ping:bing": "curl -s 'https://www.bing.com/ping?sitemap=https://robertleggett.com.au/sitemap.xml'",
    "ping:yandex": "curl -s 'https://api.indexnow.org/indexnow?url=https://robertleggett.com.au/&key=1234abcd5678ef901234abcd5678ef90'"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@mdx-js/mdx": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@next/third-parties": "^16.4.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^14.6.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.4",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "semantic-release": "^25.0.9",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "^12.2.1"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.7"
    }
  }
}
